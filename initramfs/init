#!/bin/sh

mount -t proc none /proc
mount -t sysfs none /sys

echo "[initrd] boot started"

ip link set lo up

ip link set eth0 up 2>/dev/null || true
udhcpc -i eth0 2>/dev/null || true

if [ -f /overlay/inventory.sh ]; then
  echo "[initrd] running overlay"
  /overlay/inventory.sh
fi

if [ -f /collector/collector.py ]; then
  echo "[initrd] running collector"
  python3 /collector/collector.py
fi

echo "[initrd] inventory complete"

poweroff -f
