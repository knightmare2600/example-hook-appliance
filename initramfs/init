#!/bin/bash

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

set +e

# Basic console + mounts
exec 0</dev/console 1>/dev/console 2>&1

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

echo "[runtime] provisioning runtime booted"

hostname provisioner

# Loopback
ip link set lo up 2>/dev/null || true

# Bring up available NICs
for i in /sys/class/net/*; do
  iface=$(basename "$i")
  [ "$iface" = "lo" ] && continue
  echo "[network] bringing up $iface"
  ip link set "$iface" up 2>/dev/null || true
  dhclient "$iface" 2>/dev/null || true
done

echo
echo "[runtime] detected interfaces:"
ip addr 2>/dev/null || true

echo
echo "[runtime] storage inventory:"
lsblk 2>/dev/null || true

echo
echo "[runtime] PCI devices:"
lspci 2>/dev/null || true

echo
echo "[runtime] DMI inventory:"
dmidecode 2>/dev/null || true

echo
echo "[runtime] RAID inventory:"
cat /proc/mdstat 2>/dev/null || true

echo
echo "[runtime] NVMe inventory:"
nvme list 2>/dev/null || true

# Optional overlay hook
if [ -f /overlay/inventory.sh ]; then
  echo "[runtime] running overlay inventory script"
  bash /overlay/inventory.sh || true
fi

# Optional collector
if [ -f /collector/collector.py ]; then
  echo "[runtime] running collector"
  python3 /collector/collector.py || true
fi

# SSH setup (optional but safe)
echo "[ssh] generating host keys"
ssh-keygen -A 2>/dev/null || true

mkdir -p /run/sshd

echo "[ssh] starting ssh daemon"
/usr/sbin/sshd 2>/dev/null || true

echo
echo "[runtime] entering shell"

# FINAL: stable interactive shell (PID 1 must not exit)
exec /bin/bash
